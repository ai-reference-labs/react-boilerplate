{
  "name": "@react-nx-bootstrap-portal/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "prepare": "husky",
    "dev": "nx dev portal",
    "dev:intake": "nx dev portal --port=4201",
    "dev:planning": "nx dev portal --port=4202",
    "build": "cross-env NODE_ENV=production nx build portal",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "lint-staged",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test --configuration=ci",
    "test:intake": "nx test intake-feature --configuration=ci",
    "test:planning": "nx test planning-feature --configuration=ci",
    "graph": "nx graph",
    "e2e": "nx e2e @react-nx-bootstrap-portal/portal-e2e"
  },
  "private": true,
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "dependencies": {
    "next": "^16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@next/eslint-plugin-next": "^16.3.8",
    "@nx/devkit": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/next": "23.2.1",
    "@nx/playwright": "23.2.1",
    "@nx/react": "23.2.1",
    "@nx/vitest": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@playwright/test": "^1.37.0",
    "@swc-node/register": "~1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "~1.15.5",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "~4.1.0",
    "@vitest/ui": "~4.1.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.3.8",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-playwright": "^1.6.2",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.1.0",
    "lint-staged": "^17.6.0",
    "nx": "23.2.1",
    "prettier": "~3.6.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vitest": "~4.1.0"
  },
  "workspaces": [
    "apps/*",
    "libs/intake/*",
    "libs/planning/*",
    "libs/ui/*",
    "libs/auth/*",
    "libs/shared/*"
  ]
}
